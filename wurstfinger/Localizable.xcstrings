    "Saves or loads every keyboard setting, including clipboard history, as a file.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert oder lädt alle Tastatureinstellungen einschließlich des Zwischenablageverlaufs als Datei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ou charge tous les réglages du clavier, historique du presse-papiers compris, dans un fichier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda o carga todos los ajustes del teclado, incluido el historial del portapapeles, como archivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva o carica tutte le impostazioni della tastiera, inclusa la cronologia degli appunti, come file."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет или загружает все настройки клавиатуры, включая историю буфера обмена, в виде файла."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje lub wczytuje wszystkie ustawienia klawiatury, w tym historię schowka, jako plik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparar eller läser in alla tangentbordsinställningar, inklusive urklippshistorik, som en fil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaa tai lataa kaikki näppäimistön asetukset leikepöydän historia mukaan lukien tiedostona."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprema ili učitava sve postavke tipkovnice, uključujući povijest međuspremnika, kao datoteku."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר או טוען את כל הגדרות המקלדת, כולל היסטוריית לוח העריכה, כקובץ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu hoặc tải mọi cài đặt bàn phím, gồm cả lịch sử bộ nhớ tạm, dưới dạng tệp."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sine-save o nilo-load ang lahat ng setting ng keyboard, kasama ang history ng clipboard, bilang file."
          }
        }
      }
