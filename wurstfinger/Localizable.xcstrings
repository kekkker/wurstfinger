    "Slide on space to move the cursor, on backspace to select and delete": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Leertaste schieben bewegt den Cursor, auf Löschen markiert und löscht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez sur espace pour déplacer le curseur, sur effacer pour sélectionner et supprimer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra sobre espacio para mover el cursor y sobre borrar para seleccionar y eliminar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina sullo spazio per spostare il cursore, su cancella per selezionare ed eliminare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скользите по пробелу, чтобы двигать курсор, по удалению, чтобы выделить и стереть"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuwaj po spacji, by przesunąć kursor, a po usuwaniu, by zaznaczyć i usunąć"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glid på mellanslag för att flytta markören, på radera för att markera och ta bort"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liu'uta välilyönnillä siirtääksesi kohdistinta, poistossa valitaksesi ja poistaaksesi"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klizanjem po razmaku pomičete kursor, po brisanju označavate i brišete"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גררו על רווח כדי להזיז את הסמן, ועל מחיקה כדי לבחור ולמחוק"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trượt trên phím cách để di chuyển con trỏ, trên phím xóa để chọn và xóa"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-slide sa space para ilipat ang cursor, sa backspace para pumili at magbura"
          }
        }
      }
    },
