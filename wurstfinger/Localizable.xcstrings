    "Copies stay in the keyboard's history instead of the system clipboard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien bleiben im Tastaturverlauf statt in der System-Zwischenablage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies restent dans l'historique du clavier plutôt que dans le presse-papiers système"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias se quedan en el historial del teclado en lugar del portapapeles del sistema"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie restano nella cronologia della tastiera invece che negli appunti di sistema"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии остаются в истории клавиатуры, а не в системном буфере"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie zostają w historii klawiatury zamiast w schowku systemowym"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopior stannar i tangentbordets historik i stället för systemets urklipp"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiot jäävät näppäimistön historiaan järjestelmän leikepöydän sijaan"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopije ostaju u povijesti tipkovnice umjesto u sistemskom međuspremniku"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההעתקות נשמרות בהיסטוריית המקלדת במקום בלוח העריכה של המערכת"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao nằm trong lịch sử bàn phím thay vì bộ nhớ tạm hệ thống"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nananatili ang mga kopya sa history ng keyboard sa halip na sa system clipboard"
          }
        }
      }
    },
    "Pinned items are never removed automatically.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Einträge werden nie automatisch entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments épinglés ne sont jamais supprimés automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos fijados nunca se eliminan automáticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi fissati non vengono mai rimossi automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплённые записи никогда не удаляются автоматически."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypięte elementy nigdy nie są usuwane automatycznie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fästa objekt tas aldrig bort automatiskt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinnitettyjä kohteita ei koskaan poisteta automaattisesti."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikvačene stavke nikad se ne uklanjaju automatski."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים מוצמדים לעולם לא נמחקים אוטומטית."
          }
        },
        "vi": {
