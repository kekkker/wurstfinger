    "Keeps what you copy. Swipe down and back on the 123 key to open it. Needs Full Access.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert, was du kopierst. Zum Öffnen auf der 123-Taste nach unten und zurück wischen. Erfordert vollen Zugriff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve ce que vous copiez. Balayez vers le bas et revenez sur la touche 123 pour l'ouvrir. Nécessite l'accès complet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda lo que copias. Desliza hacia abajo y vuelve en la tecla 123 para abrirlo. Requiere acceso total."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva ciò che copi. Scorri in basso e torna sul tasto 123 per aprirla. Richiede l'accesso completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет скопированное. Откройте свайпом вниз и обратно на клавише 123. Нужен полный доступ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapamiętuje to, co kopiujesz. Otwórz, przesuwając w dół i z powrotem na klawiszu 123. Wymaga pełnego dostępu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparar det du kopierar. Öppna genom att svepa ned och tillbaka på 123-tangenten. Kräver full åtkomst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaa kopioimasi. Avaa pyyhkäisemällä alas ja takaisin 123-näppäimellä. Vaatii täyden käyttöoikeuden."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamti ono što kopirate. Otvorite povlačenjem prema dolje i natrag na tipki 123. Zahtijeva puni pristup."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר את מה שאתם מעתיקים. לפתיחה החליקו למטה וחזרה על מקש 123. דורש גישה מלאה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu những gì bạn sao chép. Vuốt xuống rồi quay lại trên phím 123 để mở. Cần Quyền truy cập đầy đủ."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinatandaan ang kinokopya mo. Mag-swipe pababa at pabalik sa 123 key para buksan. Kailangan ng Full Access."
          }
        }
      }
    },
